// Pendel — файл окружения. Секреты: файл в .gitignore, не коммитится.
// Формат — C-дефайны: подставляются в прошивку на этапе сборки и служат
// дефолтами до первого сохранения настроек из админки (NVS приоритетнее).

// --- Wi-Fi домашней сети ---
#define PENDEL_WIFI_SSID ""
#define PENDEL_WIFI_PASS ""

// --- Расписание (ЧЧ:ММ, локальное время) ---
#define PENDEL_BEDTIME     "22:00"  // отбой
#define PENDEL_SLEEP_START "22:30"  // сон с
#define PENDEL_SLEEP_END   "07:00"  // сон до

// --- Вызов ---
#define PENDEL_CALL_DURATION_SEC 60  // длительность вызова, сек

// --- Часовой пояс (POSIX TZ) ---
#define PENDEL_TZ "EET-2EEST,M3.5.0/3,M10.5.0/4"

// --- Имена детей (UTF-8, до ~23 байт) ---
#define PENDEL_CHILD1 "Ребёнок 1"
#define PENDEL_CHILD2 "Ребёнок 2"

// --- Telegram-бот ---
#define PENDEL_TG_TOKEN ""
